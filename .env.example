# WorldMesh Monorepo Environment Variables

# Node Version (Cloudflare Pages reads .nvmrc, or this variable)
NODE_VERSION=20

# Hub Webhook for Submissions
# VITE_NOTIFY_WEBHOOK=https://...

# Hub URL for Worlds (used by demo worlds to link back to the directory)
# In development, defaults to http://localhost:5170/
# In production, defaults to https://worldmesh-hub.pages.dev/
# VITE_WORLDMESH_HUB=https://worldmesh-hub.pages.dev/

# Custom Base Domain (optional)
# If set (e.g. worldmesh.net), worlds link to https://worldmesh.net/
# and hub links to https://<world>.worldmesh.net/
# VITE_WORLDS_BASE_DOMAIN=worldmesh.net

# Presence server for the hub's walk mode (workers/presence), as a WebSocket base.
# In development, defaults to ws://localhost:8787 (npm run dev:presence)
# In production, defaults to wss://worldmesh-presence.elias-willnat.workers.dev
# VITE_PRESENCE_ENDPOINT=wss://presence.worldmesh.net

# Individual World URLs for the Hub (optional)
# VITE_WORLD_FOREST_URL=https://worldmesh-forest.pages.dev/
# VITE_WORLD_MARS_URL=https://worldmesh-mars.pages.dev/
# VITE_WORLD_CITY_URL=https://worldmesh-city.pages.dev/
# VITE_WORLD_MEDIEVAL_URL=https://worldmesh-medieval.pages.dev/
# VITE_WORLD_SPACE_URL=https://worldmesh-space.pages.dev/
