# WorldMesh Hub Configuration

# Webhook for new world submissions (Zapier, Make, n8n, Cloudflare Worker, etc.)
# VITE_NOTIFY_WEBHOOK=https://...

# Custom Base Domain (optional)
# Set this to use custom subdomains instead of *.pages.dev
# e.g. VITE_WORLDS_BASE_DOMAIN=worldmesh.net
# -> Hub links to forest.worldmesh.net, mars.worldmesh.net, etc.
# VITE_WORLDS_BASE_DOMAIN=

# Individual World URLs (optional overrides)
# In development, these default to http://localhost:5171..5175
# In production, these default to https://worldmesh-<world>.pages.dev/
# VITE_WORLD_FOREST_URL=https://worldmesh-forest.pages.dev/
# VITE_WORLD_MARS_URL=https://worldmesh-mars.pages.dev/
# VITE_WORLD_CITY_URL=https://worldmesh-city.pages.dev/
# VITE_WORLD_MEDIEVAL_URL=https://worldmesh-medieval.pages.dev/
# VITE_WORLD_SPACE_URL=https://worldmesh-space.pages.dev/
