/*
  X-Content-Type-Options: nosniff
  Permissions-Policy: xr-spatial-tracking=(self)

/connect.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# The runtime loadWorldMesh runs (packages/runtime/scripts/build-hosted.mjs),
# imported by worlds on other origins. The zone's Browser Cache TTL stretches
# this max-age to 4 hours; what keeps worlds within 5 minutes of the current
# runtime is loadWorldMesh asking for index.js?v=<5-minute slot>. The chunks
# it names are content-hashed and never change.
/runtime/1/index.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=300

/runtime/1/c/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable
