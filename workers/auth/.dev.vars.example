# Copy to .dev.vars for `npm run dev:auth`. Never commit .dev.vars.
# The hub dev server (localhost:5170) proxies /api/auth and /api/account here,
# so OAuth callbacks go to http://localhost:5170/api/auth/callback/<provider>.
BETTER_AUTH_URL=http://localhost:5170
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
# Production redirects: https://worldmesh.net/api/auth/callback/<provider>
# See docs/accounts-and-federation.md (OAuth provider setup).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth Apps allow one callback URL, so use a separate dev app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord: add http://localhost:5170/api/auth/callback/discord under OAuth2 → Redirects
# (or use a separate Discord application for local development).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Apple refuses localhost return URLs; test Apple on the deployed site (or an https tunnel).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional: email verification + password reset for email/password accounts
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=WorldMesh <accounts@worldmesh.net>
# Avatar Wallet (docs/avatar-wallet.md). Off until AVATAR_SECRET is set.
AVATAR_SECRET=dev-only-avatar-secret-change-me-dev-only
# VRoid Hub app with redirect URI http://localhost:5170/api/account/avatar/callback/vroid
VROID_CLIENT_ID=
VROID_CLIENT_SECRET=
# Sketchfab app with redirect URI http://localhost:5170/api/account/avatar/callback/sketchfab
SKETCHFAB_CLIENT_ID=
SKETCHFAB_CLIENT_SECRET=
# at3d / AT Protocol needs no client credentials, but its localhost client only
# accepts loopback IPs: to test it, set BETTER_AUTH_URL=http://127.0.0.1:5170
# and open the hub at that address.
