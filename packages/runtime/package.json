{
  "name": "@worldmesh/runtime",
  "version": "0.2.1",
  "description": "The shared WorldMesh navigation runtime: controls, movement, camera, player, abilities and portals.",
  "keywords": [
    "worldmesh",
    "three",
    "threejs",
    "3d",
    "webgl",
    "controls",
    "movement",
    "first-person",
    "third-person",
    "portals"
  ],
  "homepage": "https://github.com/eliaswillnat/worldmesh/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/eliaswillnat/worldmesh/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliaswillnat/worldmesh.git",
    "directory": "packages/runtime"
  },
  "author": "Elias Willnat",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && node scripts/check-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "three": "^0.169.0"
  }
}
